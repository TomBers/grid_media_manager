# Copy this file to .env and fill in the values for local development.
# The .env file is ignored by git.

RATIONAL_GRID_BASE_URL=https://rationalgrid.ai
PUBLIC_BASE_URL=http://localhost:4001

RATIONALGRID_PROMOTION_API_TOKEN=
PEXELS_API_KEY=

AWS_REGION=eu-west-2
S3_BUCKET=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Video Buffer account (Instagram, YouTube Shorts, TikTok)
BUFFER_API_KEY=
BUFFER_VIDEO_API_KEY=
BUFFER_CHANNEL_INSTAGRAM=
BUFFER_CHANNEL_YOUTUBE=
BUFFER_CHANNEL_TIKTOK=

# Text Buffer account (X, LinkedIn, Facebook)
BUFFER_TEXT_API_KEY=
BUFFER_TEXT_CHANNEL_X=
BUFFER_TEXT_CHANNEL_LINKEDIN=
BUFFER_TEXT_CHANNEL_FACEBOOK=
